{
  "name": "inside-the-jet-engine",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "desktop:dev": "concurrently --kill-others-on-fail \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:open": "electron .",
    "desktop:dist": "npm run build && electron-builder --win --x64",
    "desktop:portable": "npm run build && electron-builder --win portable --x64",
    "desktop:installer": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "katex": "^0.16.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "electron": "44.9.0",
    "electron-builder": "^26.0.0",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.4"
  },
  "productName": "Inside the Jet Engine",
  "main": "electron/main.cjs",
  "description": "Interactive jet engine engineering encyclopedia — desktop edition",
  "author": "Emine Yasan",
  "build": {
    "appId": "com.insidethejetengine.desktop",
    "productName": "Inside the Jet Engine",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "desktop-assets/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop-assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
